# Copy to `.env.local` for Next.js (never commit `.env.local`).

# Public: browser → FastAPI (must match CORS on the API, e.g. http://localhost:3000).
NEXT_PUBLIC_APEX_API_URL=http://localhost:8000

# Server-only: Next.js server components → FastAPI (same host as above when running locally).
APEX_API_URL=http://localhost:8000

# Must match services/api INTERNAL_API_KEY in the repo root `.env`.
INTERNAL_API_KEY=

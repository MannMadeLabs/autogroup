# -----------------------------------------------------------------------------
# Project Apex — copy to `.env` and inject client keys (Key Swap protocol).
# -----------------------------------------------------------------------------

# PostgreSQL (Docker Compose defaults match these unless overridden)
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex
DATABASE_URL=postgresql://apex:apex@postgres:5432/apex

# WordPress (MariaDB)
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=rootsecret

# Logic Engine — Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Logic Engine — SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# GA4 / Google (Dashboard attribution — optional for local dev)
GA4_PROPERTY_ID=
# Path inside container or JSON string; wire up per deployment
GOOGLE_APPLICATION_CREDENTIALS=

# Next.js (public)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
# Server-side fetch to FastAPI from web container
LOGIC_ENGINE_URL=http://logic-engine:8000

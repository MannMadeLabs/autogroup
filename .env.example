# Copy to .env and adjust. Never commit .env.

# --- FastAPI (services/api) ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Optional: reject webhooks if header does not match (see docs)
WEBHOOK_SECRET=

# Twilio (SMS) — leave empty to log-only in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Postgres (used by API and future persistence)
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex

# WordPress (Docker — change for production)
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
MYSQL_ROOT_PASSWORD=rootsecret

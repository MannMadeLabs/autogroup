# =========================================================================
# Project Apex - Master Environment Template
# Copy to `.env` at the repo root and fill values for each new client.
# All services read from this single source of truth via docker-compose.
# =========================================================================

# -------- Core --------
APEX_ENV=development
APEX_CLIENT_SLUG=auto-company
APEX_PUBLIC_URL=http://localhost:3000
APEX_ADMIN_URL=http://localhost:3001
APEX_API_URL=http://localhost:8000
APEX_WP_URL=http://localhost:8080

# -------- PostgreSQL (FastAPI Logic Engine) --------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-postgres

# -------- MariaDB (WordPress) --------
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me-wp

# -------- WordPress secrets (paste from https://api.wordpress.org/secret-key/1.1/salt/) --------
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# -------- JWT (shared between WP and FastAPI) --------
APEX_JWT_SECRET=change-me-jwt-secret
APEX_JWT_ALGORITHM=HS256
APEX_JWT_TTL_MINUTES=60

# -------- Twilio (SMS) --------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -------- SendGrid (Email) --------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@example.com
SENDGRID_FROM_NAME=Auto Company

# -------- Google Analytics 4 --------
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=/run/secrets/ga4-service-account.json

# -------- Stripe (future) --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -------- GTM (frontend) --------
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=Auto Company

# =============================================================================
# Project Apex — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# --- Runtime ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=info

# FastAPI bind (override in Docker via Dockerfile CMD if needed)
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins for CORS (browser → API). Local Next.js default:
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Used by `docker-compose.yml` for the `postgres` service.
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex

# FastAPI connection string.
# • Inside Docker Compose: set automatically from POSTGRES_* (see docker-compose.yml).
# • API on host machine + Postgres in Docker: use localhost and exposed port:
#   DATABASE_URL=postgresql://apex:apex@localhost:5432/apex
# • SQLAlchemy sync URL (psycopg v3): postgresql+psycopg://...
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex

# -----------------------------------------------------------------------------
# Golden image / first tenant (single-tenant MVP)
# Replace when provisioning real tenants per docs/TENANT-AND-INFRA-RULES.md
# -----------------------------------------------------------------------------
TENANT_ID=
TENANT_SLUG=mann-co

# -----------------------------------------------------------------------------
# Webhooks (ingress)
# -----------------------------------------------------------------------------
# If set, callers must send header: X-Apex-Secret: <same value>
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Internal APIs (MVP dashboard / scripts)
# -----------------------------------------------------------------------------
# If set, required header for read-only lead routes: X-Internal-Key: <value>
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Twilio (SMS) — optional; empty = log-only in development
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# SendGrid (email)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# -----------------------------------------------------------------------------
# WordPress stack (Docker Compose only — MariaDB + WP)
# -----------------------------------------------------------------------------
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
MYSQL_ROOT_PASSWORD=rootsecret

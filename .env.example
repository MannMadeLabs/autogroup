# ──────────────────────────────────────────────────────────────────────────────
# PROJECT APEX — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=apex
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=changeme_strong_password

# ── MySQL (WordPress) ─────────────────────────────────────────────────────────
WP_DB_NAME=apex_wp
WP_DB_USER=wp_user
WP_DB_PASSWORD=changeme_strong_password
MYSQL_ROOT_PASSWORD=root_changeme_strong_password

# ── FastAPI Backend ───────────────────────────────────────────────────────────
SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15555555555

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourshop.com
SENDGRID_FROM_NAME=Auto Service

# ── Google Analytics 4 ───────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret
GA4_PROPERTY_ID=properties/123456789

# ── Google Tag Manager ────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Frontend URLs ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WP_URL=http://localhost:8080

# ── WordPress ─────────────────────────────────────────────────────────────────
WP_JWT_SECRET=generate_strong_secret_for_wp_jwt
WORDPRESS_DEBUG=false

# ── Stripe (optional — for booking deposits) ──────────────────────────────────
# Replace with your actual keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ── Deployment ────────────────────────────────────────────────────────────────
# Set to your actual domain for production
SITE_DOMAIN=portal.clientname.com

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/lead.json",
  "title": "Project Apex Lead",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "customer", "vehicle", "status", "timestamp"],
  "properties": {
    "lead_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": ["fb_ad", "google_search", "organic"]
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone", "email"],
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make", "model", "service_needed"],
      "properties": {
        "make": { "type": "string" },
        "model": { "type": "string" },
        "service_needed": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "booked", "completed"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}

# =============================================================================
# DEMO environment — copy to repo root `.env` on demo hosts / team sandbox.
# Disposable passwords OK. Prefer Twilio/SendGrid sandbox or leave messaging empty.
# =============================================================================

APP_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=8000

# Local Next + API on same machine (adjust if using a shared demo hostname)
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex_demo

DATABASE_URL=postgresql://apex:apex@localhost:5432/apex_demo

TENANT_ID=
TENANT_SLUG=mann-co

WEBHOOK_SECRET=

INTERNAL_API_KEY=change-me-demo-only

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=
REVIEW_REQUEST_URL=

WORDPRESS_DB_NAME=wordpress_demo
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
MYSQL_ROOT_PASSWORD=rootsecret

# =============================================================================
# PRODUCTION — live traffic. Store real values in a vault or host env, never in git.
# Use strong unique passwords and rotate keys per tenant policy.
# =============================================================================

APP_ENV=production
LOG_LEVEL=warning

API_HOST=0.0.0.0
API_PORT=8000

# Only real customer-facing origins (no localhost)
CORS_ORIGINS=https://www.yourcompany.com,https://portal.yourcompany.com

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Managed Postgres or Compose — use TLS to DB when available
DATABASE_URL=

TENANT_ID=
TENANT_SLUG=mann-co

WEBHOOK_SECRET=

INTERNAL_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=
REVIEW_REQUEST_URL=

WORDPRESS_DB_NAME=
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

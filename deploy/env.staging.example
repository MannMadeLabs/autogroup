# =============================================================================
# STAGING — semi-production. Must NOT share DB credentials or API keys with prod.
# Replace example.com with your real staging hostnames.
# =============================================================================

APP_ENV=staging
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=8000

# Public staging Next.js origin(s), e.g. https://staging-www.example.com
CORS_ORIGINS=https://staging-www.example.com,http://localhost:3000

POSTGRES_USER=apex_staging
POSTGRES_PASSWORD=GENERATE_STRONG_UNIQUE_PASSWORD
POSTGRES_DB=apex_staging

# Inside Compose on the staging server: host `postgres`. From laptop tunneled: localhost.
DATABASE_URL=postgresql://apex_staging:GENERATE_STRONG_UNIQUE_PASSWORD@postgres:5432/apex_staging

TENANT_ID=
TENANT_SLUG=mann-co

WEBHOOK_SECRET=GENERATE_RANDOM_SECRET

INTERNAL_API_KEY=GENERATE_RANDOM_INTERNAL_KEY

# Staging Twilio subaccount or sandbox sender recommended
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=staging-alerts@yourcompany.com
REVIEW_REQUEST_URL=https://g.page/your-staging-review-placeholder

WORDPRESS_DB_NAME=wordpress_staging
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=GENERATE_STRONG_UNIQUE_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_UNIQUE_PASSWORD
